rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Station Validation
    function isValidStation(data) {
      return data.keys().hasAll(['name', 'areaType', 'expirationDate', 'currentVolume', 'initialVolume', 'createdAt', 'updatedAt'])
        && data.keys().size() == 7
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.areaType is string && data.areaType.size() > 0 && data.areaType.size() <= 50
        && data.expirationDate is string && data.expirationDate.size() == 10
        && data.currentVolume is number && data.currentVolume >= 0 && data.currentVolume <= 2000
        && data.initialVolume is number && data.initialVolume > 0 && data.initialVolume <= 2000
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Usage Log Validation
    function isValidLog(data, stationId) {
      return data.keys().hasAll(['stationId', 'previousVolume', 'currentVolume', 'usageAmount', 'recordedAt'])
        && data.keys().size() >= 5
        && data.stationId == stationId
        && data.previousVolume is number
        && data.currentVolume is number
        && data.usageAmount == data.previousVolume - data.currentVolume
        && data.recordedAt == request.time;
    }

    // 1. Stations
    match /stations/{stationId} {
      allow read: if true; // Public access as requested for direct links
      allow create: if isSignedIn() && isValidId(stationId) && isValidStation(incoming());
      allow update: if isSignedIn() && isValidId(stationId) && (
        // Action: Record Usage (Only currentVolume and updatedAt change)
        (incoming().diff(existing()).affectedKeys().hasOnly(['currentVolume', 'updatedAt']) 
          && incoming().currentVolume is number 
          && incoming().updatedAt == request.time)
        ||
        // Action: Edit Station (Can change name, areaType, expirationDate, initialVolume)
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'areaType', 'expirationDate', 'initialVolume', 'updatedAt'])
          && incoming().updatedAt == request.time)
      );
      allow delete: if isSignedIn();

      // 2. Logs (Sub-collection)
      match /logs/{logId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(logId) && isValidLog(incoming(), stationId);
      }
    }

    // 3. Ward Settings
    match /wardSettings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
